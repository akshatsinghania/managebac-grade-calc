{
  "manifest_version": 3,
  "name": "Akshat managebac",
  "version": "1.0",
  "description": "Extracts category weightage and assignment scores from the sidebar.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/student/classes/*/core_tasks"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}